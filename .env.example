# App
PORT=5002
FRONTEND_URL=http://localhost:3002
FRONTEND_ORIGINS=http://localhost:3002
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_SECRET=replace-with-a-long-random-secret

# MySQL pool and compatible Elasticsearch/OpenSearch endpoint
DB_POOL_MAX=30
DB_POOL_QUEUE_LIMIT=0
SEARCH_URL=http://127.0.0.1:9200
SEARCH_USERS_INDEX=connect-love-users
SEARCH_USERNAME=
SEARCH_PASSWORD=
SEARCH_TIMEOUT_MS=1500

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_a_long_webhook_secret
