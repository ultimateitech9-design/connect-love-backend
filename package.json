{
  "name": "@dating-app/backend",
  "version": "1.0.0",
  "description": "SoulMatch NestJS API",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,kyc -c magenta,yellow \"npm run dev:api\" \"npm run dev:kyc\"",
    "dev:api": "echo Backend API server: http://localhost:5002 && nodemon --watch src -e ts,json --exec \"nest start\"",
    "dev:kyc": "python -m uvicorn app:app --app-dir face-service --host 127.0.0.1 --port 8001",
    "install:kyc": "python -m pip install -r face-service/requirements.txt",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "tsc --noEmit",
    "db:create": "node scripts/create-database.js",
    "db:seed": "node scripts/seed-core.js",
    "db:seed:core": "node scripts/seed-core.js",
    "db:setup": "npm run db:create && npm run migration:run && npm run db:seed:core",
    "migration:run": "npm run build && typeorm migration:run -d dist/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/typeorm": "10.0.2",
    "@nestjs/websockets": "^10.4.15",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "crypto-js": "^4.2.0",
    "dotenv": "16.5.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.0",
    "helmet": "8.2.0",
    "mysql2": "3.14.0",
    "nodemailer": "^9.0.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.3",
    "typeorm": "0.3.22"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.40",
    "@types/bcryptjs": "2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "4.0.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "typescript": "5.8.3"
  }
}
